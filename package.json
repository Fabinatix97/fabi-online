{
    "name": "fabi-online",
    "version": "2.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "generate": "nuxt generate",
        "format": "eslint . --fix",
        "lint": "eslint .",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "typecheck": "nuxi typecheck && node node_modules/typescript-next/bin/tsc --noEmit --project .nuxt/tsconfig.node.json && node node_modules/typescript-next/bin/tsc --noEmit --project .nuxt/tsconfig.server.json",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "prepare": "husky"
    },
    "dependencies": {
        "@headlessui/vue": "^1.7.23",
        "@nuxt/content": "^3.2.1",
        "@nuxt/eslint": "^1.1.0",
        "@nuxt/fonts": "^1.0.0",
        "@nuxt/icon": "^2.6.2",
        "@nuxt/image": "^2.1.0",
        "@vueuse/nuxt": "^15.0.0",
        "feed": "^6.0.0",
        "gray-matter": "^4.0.3",
        "mermaid": "^12.0.0",
        "nuxt": "^4.6.4",
        "posthog-js": "^1.223.3"
    },
    "devDependencies": {
        "@nuxt/test-utils": "^4.3.2",
        "@tailwindcss/vite": "^4.3.5",
        "@types/node": "^26.6.6",
        "@vitest/coverage-v8": "^5.0.0",
        "@vitest/ui": "^5.0.0",
        "@vue/test-utils": "^2.4.6",
        "eslint": "^10.0.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.3",
        "happy-dom": "^21.0.0",
        "husky": "^9.1.7",
        "prettier": "^3.5.2",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "sass": "^1.83.1",
        "tailwindcss": "^4.3.5",
        "typescript": "5.9.3",
        "typescript-next": "npm:typescript@7.0.2",
        "vitest": "^5.0.0",
        "vue": "^3.5.45",
        "vue-router": "^5.5.1",
        "vue-tsc": "^3.0.0"
    }
}
