{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":enableVulnerabilityAlertsWithLabel(Type: Security)", // custom label for security PRs created by Renovatebot
    ":label(Type: Dependency)", // custom label for PRs created by Renovatebot
    ":semanticCommits", // enabled semantic commits in PR titles
  ],
  "lockFileMaintenance": {
    "enabled": true,
  },
  "automergeSchedule": ["* * * * *"],
  "vulnerabilityAlerts": {
    "automerge": false,
  },
  "packageRules": [
    {
      "description": "Keep the TypeScript API package on 5.x: vue-tsc and typescript-eslint still require the JS compiler API, which TypeScript 7.0 does not ship. TypeScript 7 is updated separately via the typescript-next alias.",
      "matchDepNames": ["typescript"],
      "allowedVersions": "<6.0.0",
    },
    {
      "description": "Automerge non-major updates via GitHub when required checks pass",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
    },
  ],
}
